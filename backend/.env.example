APP_NAME=AI Receptionist Platform

APP_VERSION=2.0.0

DEBUG=True

HOST=127.0.0.1

PORT=8000

DATABASE_URL=sqlite:///./ai_receptionist.db

SECRET_KEY=CHANGE_ME

ALGORITHM=HS256

ACCESS_TOKEN_EXPIRE_MINUTES=30

OLLAMA_HOST=http://localhost:11434

MODEL_NAME=qwen2.5:3b

# Optional Google Sheets lead sync. Share the spreadsheet with the service
# account email and set GOOGLE_SHEETS_CREDENTIALS_JSON to a JSON string or
# an absolute path to the service-account JSON file.
GOOGLE_SHEETS_ENABLED=False
GOOGLE_SHEET_ID=
GOOGLE_SHEET_RANGE=Leads!A:L
GOOGLE_SHEETS_CREDENTIALS_JSON=

# Optional CRM pipeline sync. Configure a CRM webhook (or a Zapier/Make/n8n
# webhook) that accepts the documented lead.upserted JSON payload.
CRM_ENABLED=False
CRM_WEBHOOK_URL=
CRM_API_KEY=
CRM_PIPELINE=Leads
CRM_STAGE=new
CRM_TIMEOUT_SECONDS=10

# Add the deployed frontend domain here, for example:
# CORS_ALLOWED_ORIGINS=https://app.yourplatform.com
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
